  m_Script: {fileID: 11500000, guid: 133475d1a5ddf1f43953ac0a926ed30f, type: 3}
  m_Name: Step 3
  m_EditorClassIdentifier: 
  _ruText: "\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439
    \u043A\u043E\u0440\u0430\u0431\u043B\u044C?\u2002\u041F\u0442\u0438\u0446\u0430
    \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442 \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u043C
    \u043F\u0430\u043B\u0435\u0442\u0435 \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442
    \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u043F\u043E\u0437\u0436\u0435.\u2002\u0415\u0441\u043B\u0438
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435 \u043F\u0430\u043B\u0435\u0442\u044B
    \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442 - \u0438\u0433\u0440\u0430
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F."
  _enText: Is there a suitable ship missing? The bird will wait on a free pallet
    and deliver the bag later. If there are no free pallets, the game is over.
  _trText: "Uygun bir gemi mi eksik?\u2002Ku\u015F bo\u015F bir palet \xFCzerinde
    bekleyecek ve \xE7antay\u0131 daha sonra teslim edecektir.\u2002Bo\u015F palet
    yoksa oyun sona erecektir."
  _ruTextStep: "\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C?\u2002\u041F\u0442\u0438\u0446\u0430
    \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442 \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u043C
    \u043F\u0430\u043B\u0435\u0442\u0435 \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442
    \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u043F\u043E\u0437\u0436\u0435.\u2002\u0415\u0441\u043B\u0438
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435 \u043F\u0430\u043B\u0435\u0442\u044B
    \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442 - \u0438\u0433\u0440\u0430
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F."
  _enTextStep: Is there a suitable ship missing? The bird will wait on a free pallet
    and deliver the bag later. If there are no free pallets, the game is over.
  _trTextStep: "Uygun bir gemi mi eksik?\u2002Ku\u015F bo\u015F bir palet \xFCzerinde
    bekleyecek ve \xE7antay\u0131 daha sonra teslim edecektir.\u2002Bo\u015F palet
    yoksa oyun sona erecektir."

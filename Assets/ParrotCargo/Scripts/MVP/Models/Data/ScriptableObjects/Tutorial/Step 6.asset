  m_Script: {fileID: 11500000, guid: 133475d1a5ddf1f43953ac0a926ed30f, type: 3}
  m_Name: Step 6
  m_EditorClassIdentifier: 
  _ruText: "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u044E\u043D\u044B\u0439
    \u043F\u0438\u0440\u0430\u0442!\u2002\u041C\u0435\u0448\u043E\u0447\u043A\u0438
    \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
    \u043D\u0430 \u043F\u0440\u0438\u0431\u044B\u0432\u0448\u0438\u0435 \u043A\u043E\u0440\u0430\u0431\u043B\u0438
    - \u043F\u043E \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u044E \u043E\u043D\u0438
    \u043F\u043E\u0434\u0430\u044E\u0442 \u0441\u0438\u0433\u043D\u0430\u043B.<br>\u0423\u0434\u0430\u0447\u0438!<br>\u041A\u0430\u0440\u0430\u043C\u0431\u0430!"
  _enText: Attention, young pirate! Bags can be delivered to arriving ships - they
    will give a signal upon arrival.<br>Good luck!<br>Karamba!
  _trText: "Dikkat gen\xE7 korsan!\u2002\xC7antalar gelen gemilere teslim edilebilir
    - vard\u0131klar\u0131nda bir sinyal verirler.<br>\u0130yi \u015Fanslar!<br>Karamba!"
  _ruTextStep: "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u044E\u043D\u044B\u0439
    \u043F\u0438\u0440\u0430\u0442!\u2002\u041C\u0435\u0448\u043E\u0447\u043A\u0438
    \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
    \u043D\u0430 \u043F\u0440\u0438\u0431\u044B\u0432\u0448\u0438\u0435 \u043A\u043E\u0440\u0430\u0431\u043B\u0438
    - \u043F\u043E \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u044E \u043E\u043D\u0438
    \u043F\u043E\u0434\u0430\u044E\u0442 \u0441\u0438\u0433\u043D\u0430\u043B.<br>\u0423\u0434\u0430\u0447\u0438!<br>\u041A\u0430\u0440\u0430\u043C\u0431\u0430!"
  _enTextStep: Attention, young pirate! Bags can be delivered to arriving ships -
    they will give a signal upon arrival.<br>Good luck!<br>Karamba!
  _trTextStep: "Dikkat gen\xE7 korsan!\u2002\xC7antalar gelen gemilere teslim edilebilir
